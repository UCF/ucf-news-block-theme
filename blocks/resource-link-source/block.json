{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ucf-today/resource-link-source",
	"title": "Resource Link Source",
	"category": "widgets",
	"description": "Outputs a Resource Link's source (first term of the `sources` taxonomy) as plain text, optionally preceded by the source icon. Use inside a Query Loop of Resource Links.",
	"textdomain": "ucf-news-block-theme",
	"keywords": [ "resource", "link", "source", "news", "taxonomy" ],
	"usesContext": [ "postId" ],
	"attributes": {
		"showIcon": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "ucf-today-resource-link-source-editor",
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": false,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalTextTransform": true,
			"__experimentalLetterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
