{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ucf-today/post-category",
	"title": "Post Category",
	"category": "text",
	"description": "Outputs the post's first category name as plain text (no link).", 
	"textdomain": "ucf-news-block-theme",
	"keywords": [ "category", "term", "post" ],
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": false,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalTextTransform": true,
			"__experimentalLetterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
