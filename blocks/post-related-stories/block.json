{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ucf-today/related-stories",
    "title": "Related Stories",
    "category": "text",
    "description": "Outputs a grid of related stories based on the current post's primary tag. Renders nothing when no tag is set.",
    "textdomain": "ucf-news-block-theme",
    "keywords": [ "related", "stories", "posts" ],
    "usesContext": [ "postId" ],
    "supports": {
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "render": "file:./render.php"
}
