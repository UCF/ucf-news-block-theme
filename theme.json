					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "1em",
						"bottom": "0.5rem"
					}
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
					"fontSize": "clamp(1.2rem, 2.5vw, 1.5rem)",
					"fontWeight": "600",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "1em",
						"bottom": "0.5rem"
					}
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
					"fontSize": "clamp(1rem, 2vw, 1.25rem)",
					"fontWeight": "600",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "1em",
						"bottom": "0.5rem"
					}
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
					"fontSize": "clamp(0.75rem, 1.5vw, 1rem)",
					"fontWeight": "600",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "1em",
						"bottom": "0.5rem"
					}
				}
			},
			"p": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "1rem"
					}
				}
			},
			"link": {
				"color": {
					"text": "#0262b6"
				},
				":hover": {
					"color": {
						"text": "#01396a"
					}
				}
			}
		},
		"blocks": {
			"core/query-pagination": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.25"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--x-large)",
						"bottom": "var(--wp--preset--spacing--x-large)"
					}
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--style--elements--link--color--text)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--style--elements--link--hover--color--text)"
							}
						}
					}
				}
			}
		}
	}
