	"styles": {
		"spacing": {
			"blockGap": "1rem",
			"padding": {
				"left": "var(--wp--preset--spacing--medium)",
				"right": "var(--wp--preset--spacing--medium)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ucf-sans-serif-alt)",
			"fontSize": "clamp(0.875rem, 2vw, 1rem)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
					"fontSize": "clamp(2rem, 4vw, 2.5rem)",
					"fontWeight": "600",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "1em",
						"bottom": "0.5rem"
					}
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
					"fontSize": "clamp(1.7rem, 3.5vw, 2rem)",
					"fontWeight": "600",
					"lineHeight": "1.1"
				},
				"spacing": {
					"margin": {
						"top": "1em",
						"bottom": "0.5rem"
					}
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
